# Secrets are env-only; they never go in config/settings.toml.
RESOLV_GITHUB_TOKEN=
RESOLV_GITHUB_WEBHOOK_SECRET=

# Claude credentials — set one of the two:
# API billing.
RESOLV_ANTHROPIC_API_KEY=
# Subscription auth from `claude setup-token`. Unprefixed on purpose — it is
# the env var name the Claude Code CLI itself reads.
CLAUDE_CODE_OAUTH_TOKEN=
